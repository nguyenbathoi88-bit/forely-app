{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forely",
  "version": "0.1.0",
  "identifier": "vn.forely.desktop",
  "build": {
    "frontendDist": "https://forely.vn"
  },
  "app": {
    "windows": [
      {
        "title": "Forely — Dự đoán & Nghiên cứu thị trường",
        "url": "https://forely.vn",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Forely",
    "shortDescription": "Forely — nền tảng dự đoán & nghiên cứu thị trường Việt Nam",
    "longDescription": "Ứng dụng desktop chính thức của forely.vn — dự đoán, khảo sát và dữ liệu thị trường Việt Nam.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
